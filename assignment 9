data("airquality")   # Built-in dataset in base R
head(airquality)
# Base R Graphics
# Scatter plot (Ozone vs Temp)
plot(airquality$Temp, airquality$Ozone,
     main = "Base: Ozone vs Temperature",
     xlab = "Temperature (F)",
     ylab = "Ozone (ppb)",
     col  = "blue", pch = 16)

# Histogram (Wind distribution)
hist(airquality$Wind,
     main = "Base: Wind Speed Distribution",
     xlab = "Wind (mph)",
     col = "lightblue", border = "black")

# Lattice Graphics
library(lattice)

# Conditional scatter plot: Ozone vs Temp by Month
xyplot(Ozone ~ Temp | factor(Month), data = airquality,
       main = "Lattice: Ozone vs Temp by Month",
       xlab = "Temperature (F)", ylab = "Ozone (ppb)",
       pch = 16, layout = c(3, 2), col = "red")

# Boxplot: Ozone by Month
bwplot(Ozone ~ factor(Month), data = airquality,
       main = "Lattice: Ozone by Month",
       xlab = "Month", ylab = "Ozone (ppb)",
       fill = "gray")

# ggplot2 Graphics
library(ggplot2)

# Scatter plot with linear smooth by Month
ggplot(airquality, aes(x = Temp, y = Ozone, color = factor(Month))) +
  geom_point(na.rm = TRUE) +
  geom_smooth(method = "lm", se = FALSE, na.rm = TRUE) +
  labs(title = "ggplot2: Ozone vs Temp by Month", x = "Temperature (F)", y = "Ozone (ppb)", color = "Month") +
  theme_minimal()

# Faceted histogram of Wind by Month
ggplot(airquality, aes(Wind)) +
  geom_histogram(binwidth = 1, fill = "skyblue", color = "black", na.rm = TRUE) +
  facet_wrap(~ Month) +
  labs(title = "ggplot2: Wind Distribution by Month", x = "Wind (mph)", y = "Count") +
  theme_minimal()

